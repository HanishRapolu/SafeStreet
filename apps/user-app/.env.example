# SafeStreets User App Environment Variables
# In Expo, variables prefixed with EXPO_PUBLIC_ are available in client code.
# For physical devices connecting to your local machine, replace localhost with your local LAN IP (e.g. 192.168.x.x) or leave unset to auto-derive from Expo dev host.

EXPO_PUBLIC_API_URL=http://localhost:5030/api
EXPO_PUBLIC_SOCKET_URL=http://localhost:5030
