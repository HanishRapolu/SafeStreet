# SafeStreets Backend Environment Configuration

# Database Configuration
MONGO_URI=mongodb://localhost:27017/safestreets
MONGODB_URI=mongodb://localhost:27017/safestreets

# Authentication
JWT_SECRET=your-super-secret-jwt-key-make-it-long-and-random-safestreets-2024
JWT_EXPIRES_IN=7d

# Tenant Owner Seed Credentials
OWNER_EMAIL=owner@safestreets.com
OWNER_PASSWORD=ownerpassword123

# Server Configuration
PORT=5030
NODE_ENV=development

# AI Model Server
AI_SERVER_URL=http://127.0.0.1:5000
AI_REQUEST_TIMEOUT=30000

# Redis Configuration
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Google Generative AI (Gemini)
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Alert Configuration
ALERT_SEVERITIES=HIGH

# Email / SMTP Configuration (leave unset to use Ethereal test inbox in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
